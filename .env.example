# Copy to .env (cp .env.example .env) and edit. .env is git-ignored; never commit it.

# Mac's LAN IP; setup.sh and first-time-setup.sh write the detected IP here (compose default 192.168.1.10)
SERVER_IP=192.168.1.10

# Pi-hole web interface password, passed to the container as WEBPASSWORD (compose default change-me)
PIHOLE_PASSWORD=change-me

# Timezone (first-time-setup.sh prompt default; docker-compose.yml currently hard-codes America/New_York)
TZ=America/New_York

# Upstream DNS servers (first-time-setup.sh option 1, Cloudflare)
DNS1=1.1.1.1
DNS2=1.0.0.1

# Host ports, written by first-time-setup.sh/resolve-ports.sh after conflict checks (standard ports shown)
DNS_PORT=53
HTTP_PORT=80
HTTPS_PORT=443
